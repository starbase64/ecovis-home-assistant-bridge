# --- Gerät ---
# MAC laut App (Einstellungen -> Geräteinformationen), ohne Doppelpunkte:
ECOVIS_MAC=AABBCCDDEE43
# Interne Protokolladresse = MAC, aber letztes Byte +1 (z. B. ...43 -> ...44):
ECOVIS_INTERNAL_ADDR=aabbccddee44

# --- MQTT-Broker ---
MQTT_HOST=192.168.1.10
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=

# --- Verhalten ---
MQTT_DISCOVERY_PREFIX=homeassistant
ECOVIS_NODE_ID=ecovis
ECOVIS_TELEMETRY_INTERVAL=60
ECOVIS_MAX_WATTS=800
